# Copy to .env and fill in. Only needed for `cartograph scan <path> --describe`;
# the plain scan runs fully offline with no key.

# Pick ONE provider.
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# Optional. Defaults: anthropic/claude-opus-5 (OpenRouter), claude-opus-5 (Anthropic).
# For OpenRouter this must be an exact slug from https://openrouter.ai/models
CARTOGRAPH_MODEL=

# Optional. Only needed to disambiguate when both keys above are set.
# CARTOGRAPH_LLM_PROVIDER=openrouter
